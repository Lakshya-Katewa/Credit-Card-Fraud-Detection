
import argparse
import os
import matplotlib
matplotlib.use("Agg")

_p = argparse.ArgumentParser()
_p.add_argument("--data", default="data/creditcard.csv")
_p.add_argument("--out", default="figures")
_p.add_argument("--sample-frac", type=float, default=None, help="quick dry run on a fraction of the data")
_args = _p.parse_args()
os.makedirs(_args.out, exist_ok=True)
_fig_n = [0]

import warnings
warnings.filterwarnings("ignore")

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.base import clone
from sklearn.compose import ColumnTransformer
from sklearn.ensemble import RandomForestClassifier
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import (
    average_precision_score, confusion_matrix, f1_score, precision_recall_curve,
    precision_score, recall_score, roc_auc_score, ConfusionMatrixDisplay,
)
from sklearn.model_selection import StratifiedKFold, cross_validate, train_test_split
from sklearn.neighbors import KNeighborsClassifier
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import RobustScaler
from sklearn.tree import DecisionTreeClassifier

sns.set_theme(style="whitegrid")

RANDOM_STATE = 42
DATA_PATH = _args.data

# Set to a fraction (e.g. 0.2) for a quick dry run; keep None for the full dataset.
DEBUG_SAMPLE_FRAC = _args.sample_frac

df = pd.read_csv(DATA_PATH)
if DEBUG_SAMPLE_FRAC:
    df = df.groupby("Class", group_keys=False).sample(frac=DEBUG_SAMPLE_FRAC, random_state=RANDOM_STATE)

print("Shape:", df.shape)
print(df.head())

print("Missing values:", int(df.isna().sum().sum()))
print("Duplicate rows:", int(df.duplicated().sum()))

counts = df["Class"].value_counts()
print("\nClass distribution:")
print(pd.DataFrame({"count": counts, "percent": (counts / len(df) * 100).round(4)}))

fig, ax = plt.subplots(figsize=(5, 3.5))
sns.countplot(x="Class", data=df, ax=ax)
ax.set_yscale("log")
ax.set_title("Class distribution (log scale)")
ax.set_xticklabels(["Legitimate (0)", "Fraud (1)"])
_fig_n[0] += 1; plt.savefig(os.path.join(_args.out, f"figure_{_fig_n[0]:02d}.png"), dpi=120, bbox_inches="tight"); plt.close("all")

fig, axes = plt.subplots(1, 2, figsize=(12, 4))
sns.histplot(df["Amount"], bins=60, ax=axes[0])
axes[0].set_yscale("log")
axes[0].set_title("Transaction amount")
sns.histplot(data=df, x="Time", hue="Class", bins=48, ax=axes[1], stat="density", common_norm=False)
axes[1].set_title("Time of transaction by class")
plt.tight_layout()
_fig_n[0] += 1; plt.savefig(os.path.join(_args.out, f"figure_{_fig_n[0]:02d}.png"), dpi=120, bbox_inches="tight"); plt.close("all")

print(df.groupby("Class")["Amount"].describe())

df = df.drop_duplicates().reset_index(drop=True)
print("Shape after dropping duplicates:", df.shape)

X = df.drop(columns="Class")
y = df["Class"]

X_trainval, X_test, y_trainval, y_test = train_test_split(
    X, y, test_size=0.20, stratify=y, random_state=RANDOM_STATE)
X_train, X_val, y_train, y_val = train_test_split(
    X_trainval, y_trainval, test_size=0.25, stratify=y_trainval, random_state=RANDOM_STATE)  # 0.25 * 0.8 = 0.2

for name, part in [("train", y_train), ("validation", y_val), ("test", y_test)]:
    print(f"{name:<11} n={len(part):>7,}  frauds={int(part.sum()):>4}  fraud rate={part.mean()*100:.3f}%")

def make_pipeline(model):
    pre = ColumnTransformer(
        [("scale", RobustScaler(), ["Time", "Amount"])],
        remainder="passthrough",
    )
    return Pipeline([("pre", pre), ("model", model)])

models = {
    "Logistic Regression": make_pipeline(LogisticRegression(
        max_iter=2000, class_weight="balanced", random_state=RANDOM_STATE)),
    "Decision Tree": make_pipeline(DecisionTreeClassifier(
        max_depth=8, min_samples_leaf=5, class_weight="balanced", random_state=RANDOM_STATE)),
    "KNN": make_pipeline(KNeighborsClassifier(n_neighbors=5, n_jobs=-1)),
    "Random Forest": make_pipeline(RandomForestClassifier(
        n_estimators=200, min_samples_leaf=2, class_weight="balanced_subsample",
        n_jobs=-1, random_state=RANDOM_STATE)),
}

cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=RANDOM_STATE)
scoring = {
    "precision": "precision",
    "recall": "recall",
    "f1": "f1",
    "roc_auc": "roc_auc",
    "pr_auc": "average_precision",
}

rows = []
for name, pipe in models.items():
    res = cross_validate(pipe, X_train, y_train, cv=cv, scoring=scoring, n_jobs=1)
    rows.append({"model": name, **{m: res[f"test_{m}"].mean() for m in scoring},
                 **{f"{m}_std": res[f"test_{m}"].std() for m in scoring}})
    print(f"done: {name}")

cv_results = pd.DataFrame(rows).set_index("model")
print(cv_results[list(scoring)].round(4).sort_values("pr_auc", ascending=False))

ax = cv_results[list(scoring)].plot(kind="bar", figsize=(10, 4), width=0.8)
ax.set_title("5-fold stratified CV results (training set)")
ax.set_ylabel("score")
ax.set_ylim(0, 1.05)
plt.xticks(rotation=0)
plt.legend(loc="lower right", ncol=5)
plt.tight_layout()
_fig_n[0] += 1; plt.savefig(os.path.join(_args.out, f"figure_{_fig_n[0]:02d}.png"), dpi=120, bbox_inches="tight"); plt.close("all")

best_name = cv_results["pr_auc"].idxmax()
print("Best model by CV PR-AUC:", best_name)

final_model = clone(models[best_name]).fit(X_train, y_train)
val_proba = final_model.predict_proba(X_val)[:, 1]

prec, rec, thr = precision_recall_curve(y_val, val_proba)
prec, rec = prec[:-1], rec[:-1]           # align with thresholds
f1s = 2 * prec * rec / np.clip(prec + rec, 1e-12, None)

MIN_PRECISION = None   # e.g. 0.90 to require at least 90% precision

valid = np.ones_like(f1s, dtype=bool) if MIN_PRECISION is None else prec >= MIN_PRECISION
if not valid.any():
    raise ValueError("No threshold satisfies MIN_PRECISION; lower it.")
best_idx = np.argmax(np.where(valid, f1s, -1))
best_threshold = float(thr[best_idx])

print(f"Selected threshold: {best_threshold:.3f}")
print(f"Validation precision: {prec[best_idx]:.3f} | recall: {rec[best_idx]:.3f} | F1: {f1s[best_idx]:.3f}")

fig, axes = plt.subplots(1, 2, figsize=(12, 4))
axes[0].plot(thr, prec, label="precision")
axes[0].plot(thr, rec, label="recall")
axes[0].plot(thr, f1s, label="F1", linestyle="--")
axes[0].axvline(best_threshold, color="k", linestyle=":", label="selected")
axes[0].set_xlabel("threshold"); axes[0].set_title("Metrics vs. threshold (validation)"); axes[0].legend()
axes[1].plot(rec, prec)
axes[1].scatter(rec[best_idx], prec[best_idx], color="red", zorder=3, label="selected")
axes[1].set_xlabel("recall"); axes[1].set_ylabel("precision")
axes[1].set_title(f"Precision-Recall curve (AP = {average_precision_score(y_val, val_proba):.3f})")
axes[1].legend()
plt.tight_layout()
_fig_n[0] += 1; plt.savefig(os.path.join(_args.out, f"figure_{_fig_n[0]:02d}.png"), dpi=120, bbox_inches="tight"); plt.close("all")

test_proba = final_model.predict_proba(X_test)[:, 1]

def report(y_true, proba, threshold):
    pred = (proba >= threshold).astype(int)
    return {
        "threshold": threshold,
        "precision": precision_score(y_true, pred, zero_division=0),
        "recall": recall_score(y_true, pred),
        "f1": f1_score(y_true, pred),
        "roc_auc": roc_auc_score(y_true, proba),
        "pr_auc": average_precision_score(y_true, proba),
    }

final_report = pd.DataFrame(
    [report(y_test, test_proba, 0.5), report(y_test, test_proba, best_threshold)],
    index=["default threshold (0.5)", "tuned threshold"],
)
print("Model:", best_name)
print(final_report.round(4))

test_pred = (test_proba >= best_threshold).astype(int)
tn, fp, fn, tp = confusion_matrix(y_test, test_pred).ravel()
print(f"TP={tp}  TN={tn}  FP={fp}  FN={fn}")
print(f"Frauds caught: {tp}/{tp+fn}  |  false alerts: {fp} out of {fp+tn:,} legitimate transactions "
      f"({fp/(fp+tn)*100:.3f}%)")

fig, axes = plt.subplots(1, 2, figsize=(11, 4))
ConfusionMatrixDisplay.from_predictions(y_test, (test_proba >= 0.5).astype(int), ax=axes[0],
                                        display_labels=["Legit", "Fraud"], colorbar=False)
axes[0].set_title("Default threshold (0.5)")
ConfusionMatrixDisplay.from_predictions(y_test, test_pred, ax=axes[1],
                                        display_labels=["Legit", "Fraud"], colorbar=False)
axes[1].set_title(f"Tuned threshold ({best_threshold:.2f})")
plt.tight_layout()
_fig_n[0] += 1; plt.savefig(os.path.join(_args.out, f"figure_{_fig_n[0]:02d}.png"), dpi=120, bbox_inches="tight"); plt.close("all")

errors = X_test.assign(Class=y_test, fraud_proba=test_proba, predicted=test_pred)
fn_df = errors[(errors.Class == 1) & (errors.predicted == 0)]
fp_df = errors[(errors.Class == 0) & (errors.predicted == 1)]

print(f"False negatives: {len(fn_df)} | median Amount = {fn_df['Amount'].median():.2f}")
print(f"False positives: {len(fp_df)} | median Amount = {fp_df['Amount'].median():.2f}")
print(f"Missed frauds (median predicted prob.): {fn_df['fraud_proba'].median():.3f}")

print(fn_df[["Time", "Amount", "fraud_proba"]].sort_values("fraud_proba", ascending=False).head(10))

estimator = final_model.named_steps["model"]
feature_names = final_model.named_steps["pre"].get_feature_names_out()
feature_names = [n.split("__", 1)[-1] for n in feature_names]

if hasattr(estimator, "feature_importances_"):
    imp = pd.Series(estimator.feature_importances_, index=feature_names).sort_values(ascending=False)
    fig, ax = plt.subplots(figsize=(7, 6))
    imp.head(15)[::-1].plot(kind="barh", ax=ax)
    ax.set_title(f"Top 15 feature importances ({best_name})")
    plt.tight_layout()
    _fig_n[0] += 1; plt.savefig(os.path.join(_args.out, f"figure_{_fig_n[0]:02d}.png"), dpi=120, bbox_inches="tight"); plt.close("all")
else:
    print(f"{best_name} has no built-in feature importances; using a Random Forest for interpretation.")
    rf = clone(models["Random Forest"]).fit(X_train, y_train)
    imp = pd.Series(rf.named_steps["model"].feature_importances_, index=feature_names).sort_values(ascending=False)
    imp.head(15)[::-1].plot(kind="barh", figsize=(7, 6), title="Top 15 feature importances (Random Forest)")
    plt.tight_layout()
    _fig_n[0] += 1; plt.savefig(os.path.join(_args.out, f"figure_{_fig_n[0]:02d}.png"), dpi=120, bbox_inches="tight"); plt.close("all")

print(imp.head(10).round(4))
